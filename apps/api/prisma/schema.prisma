// Control-plane Prisma schema (base de contrôle globale — voir ADR-001).
// Les entités metier tenant-scoped (clients, commandes, caisse, ...) vivront
// dans des schemas PostgreSQL dedies par tenant, provisionnes en 003-tenant-isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CAISSIER
  TECHNICIEN
  LIVREUR
}

enum StatutLicence {
  ESSAI
  ACTIVE
  EXPIREE
  SUSPENDUE
}

enum EvenementLicence {
  CREATION
  ACTIVATION
  RENOUVELLEMENT
  SUSPENSION
  REACTIVATION
  REVOCATION
  EXPIRATION_AUTOMATIQUE
}

// §14 : trois plans de référence. Remplace l'ancien champ texte libre
// (contrainte déjà appliquée en application via IsIn, désormais garantie
// aussi par la base — cohérent avec "jamais de confiance dans le
// frontend" appliqué symétriquement côté validation serveur).
enum PlanCommercial {
  STARTER
  PRO
  BUSINESS
}

// 021-permissions-granulaires : un override retire (DENY) ou ajoute (ALLOW)
// un droit par rapport au defaut du role. Priorite de resolution stricte :
// DENY explicite > ALLOW explicite > defaut du role (voir permissions.service.ts).
enum EffetPermission {
  ALLOW
  DENY
}

// §022-super-admin-enhancement — catalogue de référence des plans
// commerciaux (prix, limites, fonctionnalités). Distinct de Abonnement :
// Abonnement porte ce qu'un tenant paie réellement (peut diverger d'une
// négociation particulière), PlanDefinition porte le tarif/les limites de
// référence affichés par le SUPER_ADMIN. Un seul enregistrement par valeur
// de PlanCommercial, pré-créé non configuré (tous les champs nullable) —
// jamais de prix ou de limite inventés : tant que le SUPER_ADMIN ne les a
// pas renseignés, l'UI affiche "Non configuré".
model PlanDefinition {
  id                    String         @id @default(uuid())
  plan                  PlanCommercial @unique
  prixMensuel           Decimal?       @map("prix_mensuel") @db.Decimal(10, 2)
  devise                String         @default("XOF")
  limiteUtilisateurs    Int?           @map("limite_utilisateurs")
  limitePointsDeService Int?           @map("limite_points_de_service")
  fonctionnalites       String[]       @default([])
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  updatedBy             String?        @map("updated_by")

  @@map("plan_definitions")
}

model Tenant {
  id            String         @id @default(uuid())
  nomPressing   String         @map("nom_pressing")
  sousDomaine   String         @unique @map("sous_domaine")
  plan          PlanCommercial @default(STARTER)
  langue        String         @default("fr")
  devise        String         @default("XOF")
  fuseauHoraire String         @default("Africa/Dakar") @map("fuseau_horaire")
  adresse       String?
  telephone     String?
  logoUrl       String?        @map("logo_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  users                 User[]
  licence               Licence?
  supportSessions       SupportSession[]
  onboarding            OnboardingState?
  abonnement            Abonnement?
  apiKeys               ApiKey[]
  journauxSauvegarde    JournalSauvegarde[]
  userPermissions       UserPermission[]
  supportTickets        SupportTicket[]
  historiqueAbonnements HistoriqueAbonnement[]
  factures              Facture[]

  @@map("tenants")
}

// tenantId est nullable uniquement pour SUPER_ADMIN (perimetre plateforme,
// hors tenant). Tous les autres roles exigent un tenantId (impose en
// application, cf. auth.service.ts).
model User {
  id                 String   @id @default(uuid())
  tenantId           String?  @map("tenant_id")
  role               Role
  email              String
  motDePasseHash     String   @map("mot_de_passe_hash")
  pinHash            String?  @map("pin_hash")
  actif              Boolean  @default(true)
  // Force l'ecran de changement de mot de passe a la prochaine connexion —
  // active uniquement par un reset SUPER_ADMIN (jamais par le reset ADMIN
  // tenant-scope existant, qui garde son comportement historique).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  // Incremente a chaque changement de mot de passe ; verifie contre le
  // claim du JWT dans JwtStrategy pour revoquer les sessions deja emises
  // (aucun mecanisme de revocation n'existait avant cette feature).
  tokenVersion       Int      @default(0) @map("token_version")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions UserPermission[]

  @@unique([tenantId, email])
  @@map("users")
}

// 021-permissions-granulaires : overrides ADMIN au-dessus du defaut du role.
// tenantId duplique (comme AuditLog) : chaque requete filtre directement
// WHERE userId = ? AND tenantId = ? avec un tenantId derive du TenantContext
// serveur, jamais du client — meme principe d'isolation que UsersService.
// "users.manage" et "users.permissions" sont exclus de ce mecanisme au
// niveau applicatif (jamais d'override cree pour ces deux permissions,
// cf. permissions.constants.ts) pour empecher toute elevation de privilege
// deguisee en changement de permission.
model UserPermission {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  tenantId   String          @map("tenant_id")
  permission String
  effet      EffetPermission
  accordePar String          @map("accorde_par")
  createdAt  DateTime        @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, permission])
  @@index([tenantId])
  @@map("user_permissions")
}

// Statut = source de verite unique (le champ Tenant.statutLicence de 002 est
// retire au profit de ce modele dedie, conforme au modele de 004-licensing).
model Licence {
  id                     String        @id @default(uuid())
  tenantId               String        @unique @map("tenant_id")
  statut                 StatutLicence @default(ESSAI)
  dateDebutEssai         DateTime      @map("date_debut_essai")
  dateFinEssai           DateTime      @map("date_fin_essai")
  dateActivation         DateTime?     @map("date_activation")
  dateExpirationCourante DateTime?     @map("date_expiration_courante")
  cleLicenceJwt          String?       @map("cle_licence_jwt")
  derniereVerificationAt DateTime?     @map("derniere_verification_at")
  alerte48hEnvoyeeAt     DateTime?     @map("alerte_48h_envoyee_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  journal JournalLicence[]

  @@map("licences")
}

// Append-only : aucune mise a jour ni suppression d'une entree existante.
model JournalLicence {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  licenceId      String           @map("licence_id")
  evenement      EvenementLicence
  effectuePar    String?          @map("effectue_par")
  motif          String?
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")

  licence Licence @relation(fields: [licenceId], references: [id])

  @@unique([licenceId, evenement, idempotencyKey])
  @@map("journal_licences")
}

// L'audit de debut EST la creation de la ligne (started_at, motif) ;
// l'audit de fin EST sa cloture (ended_at). Append-only au sens metier :
// une session n'est jamais supprimee, seulement cloturee.
model SupportSession {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  superAdminId String    @map("super_admin_id")
  motif        String
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("support_sessions")
}

enum ActionSauvegarde {
  SAUVEGARDE
  RESTAURATION
}

// Control-plane, jamais dans le schema du tenant : une restauration
// (DROP SCHEMA CASCADE + reimport) remplace integralement le schema du
// tenant, y compris son AuditLog local — un journal qui y vivrait
// effacerait donc la preuve de sa propre restauration. Meme raison que
// SupportSession ci-dessus. Append-only : aucune mise a jour ni
// suppression d'une entree existante.
model JournalSauvegarde {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  action       ActionSauvegarde
  effectuePar  String           @map("effectue_par")
  tailleOctets Int              @map("taille_octets")
  createdAt    DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("journaux_sauvegarde")
}

enum EtapeOnboarding {
  IDENTITE
  TARIFS
  UTILISATEUR_NOTIFICATION
  TERMINE
}

enum ChoixCatalogue {
  CATALOGUE_STANDARD
  GRILLE_VIERGE
}

enum CanalNotification {
  PUSH
  WHATSAPP
  SMS
}

// Un seul enregistrement par tenant. Reprenable : chaque etape peut etre
// rappelee independamment, etape_courante n'avance jamais en arriere.
// Ne bloque jamais l'usage normal de l'application (aucun guard n'en
// depend) — seulement informatif pour reprendre le parcours.
model OnboardingState {
  id                      String             @id @default(uuid())
  tenantId                String             @unique @map("tenant_id")
  etapeCourante           EtapeOnboarding    @default(IDENTITE) @map("etape_courante")
  identiteCompleteeAt     DateTime?          @map("identite_completee_at")
  tarifsCompletesAt       DateTime?          @map("tarifs_completes_at")
  choixCatalogue          ChoixCatalogue?    @map("choix_catalogue")
  notificationCompleteeAt DateTime?          @map("notification_completee_at")
  canalPreference         CanalNotification? @map("canal_preference")
  termineAt               DateTime?          @map("termine_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("onboarding_states")
}

enum ModePaiementFacturation {
  CARTE
  MOBILE_MONEY
  VIREMENT
}

enum StatutAbonnement {
  ACTIF
  EN_RETARD
  ANNULE
}

// §14.1 : un seul abonnement actif par tenant (comme Licence, 1:1). En V1
// le tenant ne modifie jamais directement son abonnement — seul le
// SUPER_ADMIN le provisionne, et les évènements de paiement (webhook,
// simulé pour l'instant faute de credentials Stripe/Mobile Money réelles
// dans ce projet — voir specs/017-billing/spec.md) le font évoluer.
model Abonnement {
  id                       String                  @id @default(uuid())
  tenantId                 String                  @unique @map("tenant_id")
  plan                     PlanCommercial
  modePaiement             ModePaiementFacturation @map("mode_paiement")
  montant                  Decimal                 @db.Decimal(10, 2)
  devise                   String                  @default("XOF")
  statut                   StatutAbonnement        @default(ACTIF)
  dateProchaineFacturation DateTime                @map("date_prochaine_facturation")
  referenceProvider        String?                 @map("reference_provider")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  journal JournalPaiement[]

  @@map("abonnements")
}

enum TypeEvenementPaiement {
  PAIEMENT_REUSSI
  PAIEMENT_ECHEC
  RELANCE_ENVOYEE
}

// Append-only, même principe que JournalLicence (004) : aucune mise à
// jour ni suppression d'une entrée existante. idempotencyKey unique car
// un évènement de paiement porte un identifiant globalement unique côté
// fournisseur (webhook), contrairement aux clés d'action de JournalLicence
// qui sont générées par l'appelant pour une action donnée.
model JournalPaiement {
  id                String                @id @default(uuid())
  tenantId          String                @map("tenant_id")
  abonnementId      String                @map("abonnement_id")
  type              TypeEvenementPaiement
  montant           Decimal?              @db.Decimal(10, 2)
  devise            String?
  referenceProvider String?               @map("reference_provider")
  idempotencyKey    String                @unique @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at")

  abonnement Abonnement @relation(fields: [abonnementId], references: [id])

  @@map("journal_paiements")
}

// §023-subscriptions-invoicing — une ligne par changement de plan/prix,
// append-only (même principe que JournalLicence/JournalPaiement) : jamais
// modifiée ni supprimée. Abonnement ne garde que l'état courant ; ce
// journal est la seule trace de "ce qui a changé, quand, par qui,
// pourquoi" demandée pour la section "Historique abonnement".
model HistoriqueAbonnement {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  ancienPlan  PlanCommercial @map("ancien_plan")
  nouveauPlan PlanCommercial @map("nouveau_plan")
  ancienPrix  Decimal?       @map("ancien_prix") @db.Decimal(10, 2)
  nouveauPrix Decimal?       @map("nouveau_prix") @db.Decimal(10, 2)
  devise      String         @default("XOF")
  effectuePar String         @map("effectue_par")
  motif       String?
  dateEffet   DateTime       @default(now()) @map("date_effet")
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("historique_abonnements")
}

enum StatutFacture {
  EMISE
  PAYEE
  EN_RETARD
  ANNULEE
}

// §023-subscriptions-invoicing — une facture fige (snapshot) les
// informations du tenant/abonnement au moment de l'émission : jamais une
// lecture live de Tenant/Abonnement, pour qu'une facture déjà émise ne
// change jamais rétroactivement si le tenant est renommé ensuite. Pas de
// champ TVA/taxe : aucun régime fiscal n'existe dans le projet (voir
// spec.md, décision explicite). paiementRef pointe vers un JournalPaiement
// déjà existant si le paiement correspondant est déjà enregistré — jamais
// un second enregistrement du montant payé (principe append-only, jamais
// deux systèmes financiers parallèles).
model Facture {
  id               String                  @id @default(uuid())
  numero           String                  @unique
  tenantId         String                  @map("tenant_id")
  nomPressingSnap  String                  @map("nom_pressing_snapshot")
  emailProprioSnap String?                 @map("email_proprietaire_snapshot")
  planSnap         PlanCommercial          @map("plan_snapshot")
  montant          Decimal                 @db.Decimal(10, 2)
  devise           String                  @default("XOF")
  modePaiementSnap ModePaiementFacturation @map("mode_paiement_snapshot")
  periodeDebut     DateTime                @map("periode_debut")
  periodeFin       DateTime                @map("periode_fin")
  statut           StatutFacture           @default(EMISE)
  dateEmission     DateTime                @default(now()) @map("date_emission")
  dateEcheance     DateTime                @map("date_echeance")
  paiementRefId    String?                 @map("paiement_ref_id")
  emisePar         String                  @map("emise_par")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, periodeDebut])
  @@index([tenantId])
  @@map("factures")
}

// §17 "API ouverte" : chaque clé appartient à un seul tenant, possède des
// scopes, peut être révoquée, est soumise à un quota. Stockée hachée
// (SHA-256, cf. api-key.service.ts) — jamais en clair, jamais retrouvable
// après création (seul le préfixe reste affichable pour identification).
// Quota "glissant par jour" implémenté sans table séparée : le compteur
// est remis à zéro dès que compteur_reinitialise_a n'est plus le jour
// courant (voir api-key.guard.ts).
model ApiKey {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  nom                   String
  cleHachee             String    @unique @map("cle_hachee")
  clePrefixe            String    @map("cle_prefixe")
  scopes                String[]
  quotaJour             Int       @default(1000) @map("quota_jour")
  compteurJour          Int       @default(0) @map("compteur_jour")
  compteurReinitialiseA DateTime  @default(now()) @map("compteur_reinitialise_a")
  revoqueeAt            DateTime? @map("revoquee_at")
  derniereUtilisationAt DateTime? @map("derniere_utilisation_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

enum StatutTicketSupport {
  OUVERT
  EN_COURS
  RESOLU
}

enum PrioriteTicketSupport {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum AuteurMessageTicket {
  TENANT
  SUPER_ADMIN
}

// §022-super-admin-enhancement — centre de support. Control-plane (comme
// SupportSession/Abonnement) : un ticket appartient à un seul tenant
// (tenantId), n'importe quel utilisateur de ce tenant peut le créer/le
// consulter/y répondre (aucune restriction de rôle ADMIN — c'est une
// demande d'aide, pas une action administrative), mais jamais un autre
// tenant. Le SUPER_ADMIN voit et répond à tous les tickets, change leur
// statut ; il n'obtient aucun droit métier supplémentaire sur le tenant lui-
// même. "Historique" = le fil de messages, append-only comme
// JournalPaiement/JournalLicence — jamais modifié ni supprimé.
model SupportTicket {
  id          String                @id @default(uuid())
  tenantId    String                @map("tenant_id")
  auteurId    String                @map("auteur_id")
  sujet       String
  description String
  statut      StatutTicketSupport   @default(OUVERT)
  priorite    PrioriteTicketSupport @default(NORMALE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  resoluAt    DateTime?             @map("resolu_at")

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  messages SupportTicketMessage[]

  @@index([tenantId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String              @id @default(uuid())
  ticketId   String              @map("ticket_id")
  auteurId   String              @map("auteur_id")
  auteurType AuteurMessageTicket @map("auteur_type")
  corps      String
  createdAt  DateTime            @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@map("support_ticket_messages")
}

enum ActiviteBusiness {
  PRESSING_BLANCHISSERIE
  LAVAGE_AUTO
  PRESSING_LAVAGE_AUTO
  AUTRE
}

enum TypeDemandeBusiness {
  DEVIS
  INFORMATIONS
  DEMONSTRATION
  ACCOMPAGNEMENT
  AUTRE
}

enum StatutDemandeBusiness {
  NOUVEAU
  EN_COURS
  TRAITE
  REJETE
}

// Formulaire "Nous contacter" de la carte plan Business (Abonnement &
// facturation). Control-plane, comme PlanDefinition : jamais de tenantId
// obligatoire ni de relation Tenant — un visiteur anonyme (page publique
// future) n'a pas de tenant, et un visiteur connecté ne doit jamais
// pouvoir associer sa demande à un AUTRE tenant que le sien (aucune
// requête tenant-scoped ne lit jamais ce champ, il est purement informatif
// pour le SUPER_ADMIN). Pas d'AuditLog : AuditService écrit uniquement
// dans le schema dédié d'un tenant (TenantPrismaFactory.forTenant), donc
// une demande anonyme ne peut jamais être auditée — traçabilité minimale
// via traiteParSuperAdminId/traiteAt sur la ligne elle-même, comme
// PlanDefinition.updatedBy/updatedAt.
model BusinessContactRequest {
  id                    String                 @id @default(uuid())
  nomComplet            String                 @map("nom_complet")
  entreprise            String
  email                 String
  telephone             String
  typeActivite          ActiviteBusiness       @map("type_activite")
  nombrePointsDeService Int?                   @map("nombre_points_de_service")
  typeDemande           TypeDemandeBusiness    @map("type_demande")
  message               String
  statut                StatutDemandeBusiness  @default(NOUVEAU)
  tenantId              String?                @map("tenant_id")
  traiteParSuperAdminId String?                @map("traite_par_super_admin_id")
  traiteAt              DateTime?              @map("traite_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("business_contact_requests")
}
