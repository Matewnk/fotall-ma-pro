NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://fotall:change-me@localhost:5432/fotall
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me
JWT_EXPIRES_IN=12h
