NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
# Base URL de l'API que le frontend web (015) appelle. Défaut :
# http://localhost:3000 si absent (voir apps/web/src/lib/api-client.ts).
VITE_API_URL=http://localhost:3000
DATABASE_URL=postgresql://fotall:change-me@localhost:5432/fotall
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me
JWT_EXPIRES_IN=12h
# true (défaut) : les notifications sont journalisées mais aucun fournisseur
# (FCM/WhatsApp/SMS) n'est appelé. Mettre à false une fois de vraies
# credentials fournisseur branchées.
NOTIFICATIONS_DRY_RUN=true
