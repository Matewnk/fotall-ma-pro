# Copier ce fichier en ".env" (meme dossier) et remplir les vraies
# valeurs. Ne JAMAIS committer le ".env" reel (deja dans .gitignore).

# --- Domaines (2 sous-domaines DNS pointant vers l'IP du VPS) ---
WEB_DOMAIN=app.votredomaine.com
API_DOMAIN=api.votredomaine.com

# --- Base de donnees ---
POSTGRES_USER=fotall
POSTGRES_PASSWORD=change-me-mot-de-passe-fort
POSTGRES_DB=fotall
DATABASE_URL=postgresql://fotall:change-me-mot-de-passe-fort@postgres:5432/fotall

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
# Generer avec : openssl rand -hex 32
JWT_SECRET=change-me-secret-genere-aleatoirement
JWT_EXPIRES_IN=12h

# --- CORS (obligatoire en production, sinon tout est bloque) ---
CORS_ORIGINS=https://app.votredomaine.com

# --- Google OAuth (inscription/connexion Google) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
WEB_ORIGIN=https://app.votredomaine.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.votredomaine.com/auth/google/callback

# --- Build du frontend (lu uniquement au moment du build de l'image web) ---
VITE_API_URL=https://api.votredomaine.com

# --- Divers ---
NODE_ENV=production
NOTIFICATIONS_DRY_RUN=true
# Generer avec : openssl rand -hex 32
FACTURATION_WEBHOOK_SECRET=change-me-secret-genere-aleatoirement
BACKUP_STORAGE_DIR=/data/backups
BACKUP_RETENTION_JOURS=30
